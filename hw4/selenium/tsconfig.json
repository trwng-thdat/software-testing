{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "lib": ["ES2021", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node", "mocha"],
    "outDir": "dist"
  },
  "include": ["tests/**/*.ts", "utils/**/*.ts", "types/**/*.d.ts"],
  "ts-node": {
    "files": true
  }
}
