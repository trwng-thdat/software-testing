# ============================================================
# BOUNDARY VALUE ANALYSIS — TC-CHECKOUT-101 đến TC-CHECKOUT-103
# ============================================================
# Biên: min_order_amount của SAVE10 = 300000
# Chiến lược 3-value: {min-1=299999, min=300000, min+1=300001}
# RESET DB trước khi chạy nhóm BVA để đảm bảo SAVE10 chưa bị dùng

### TC-CHECKOUT-101 | BVA min-1 | total=299999 — dưới ngưỡng, từ chối là đúng
# Kỳ vọng: 400 "Đơn hàng chưa đủ giá trị tối thiểu 300.000 ₫..."
POST {{baseUrl}}/api/apply-coupon
Content-Type: application/json

{
  "code": "SAVE10",
  "total_amount": 299999
}

###

### TC-CHECKOUT-102 | BVA min | total=300000 — đúng ngưỡng
# Kỳ vọng (spec >=): 200, coupon applied
# Thực tế (BUG-B-01): 400, từ chối vì 300000 > 300000 = false (off-by-one)
POST {{baseUrl}}/api/apply-coupon
Content-Type: application/json

{
  "code": "SAVE10",
  "total_amount": 300000
}

###

### TC-CHECKOUT-103 | BVA min+1 | total=300001 — trên ngưỡng, chấp nhận
# Kỳ vọng: discount=30000 (10%), final=270001
# Thực tế (BUG-B-02): discount=-2700009, final=3000010 (công thức sai)
POST {{baseUrl}}/api/apply-coupon
Content-Type: application/json

{
  "code": "SAVE10",
  "total_amount": 300001
}

