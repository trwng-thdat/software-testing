# HW06 - cau hinh pipeline CI/CD
#
# SPEC_ENFORCED quyet dinh pipeline co chay job "spec-gate" hay khong.
#
#   false -> chi chay cong chan hoi quy (3 folder API + 3 lan chay theo du lieu).
#            Pipeline XANH. Day la cau hinh thuong ngay: bao ve khoi hoi quy.
#
#   true  -> chay them folder SPEC, noi assertion viet theo dieu DAC TA doi hoi.
#            Pipeline DO cho toi khi 17 loi trong SUT duoc sua. Day la cau hinh
#            "cong dac ta": dung khi muon CI chan lai viec giao hang trong khi
#            van con vi pham FR/SEC.
#
# De bai §6 doi hai commit mau: mot commit pipeline xanh, mot commit pipeline do.
# Dong duoi day chinh la khac biet giua hai commit do.
SPEC_ENFORCED=false
